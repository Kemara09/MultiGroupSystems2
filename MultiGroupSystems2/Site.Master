
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="MultiGroupSystemsTester.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Multigroup Inc.</asp:ContentPlaceHolder></title>

    <!-- Apply saved theme before page rendering -->
    <script>
        (function () {
            try {
                var theme = localStorage.getItem("siteTheme");
                if (theme === "dark" || theme === "light") {
                    document.documentElement.setAttribute("data-theme", theme);
                }
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/Site.css" runat="server" />

    <style>
        :root {
            color-scheme: light;
            --page-bg: #F1EFE8;
            --surface-bg: #ffffff;
            --text-color: #212529;
            --muted-text: #5F5E5A;
            --border-color: #dee2e6;
            --input-bg: #ffffff;
            --nav-bg: #0C2A44;
            --nav-text: #CDE0F2;
            --heading-color: #0C2A44;
            --link-color: #0C447C;
            --feature-bg: #ffffff;
            --cta-bg: #E9ECEF;
            --hero-bg: #2D5A82;
        }

        html[data-theme="dark"] {
            color-scheme: dark;
            --page-bg: #121820;
            --surface-bg: #1e2936;
            --text-color: #e8edf3;
            --muted-text: #b0bdcb;
            --border-color: #3b4858;
            --input-bg: #263342;
            --nav-bg: #101b28;
            --nav-text: #d5e5f5;
            --heading-color: #d5e5f5;
            --link-color: #8ab4ff;
            --feature-bg: #1e2936;
            --cta-bg: #202c39;
            --hero-bg: #1c3b56;
        }

        body {
            background: var(--page-bg);
            color: var(--text-color);
            transition: background-color .2s, color .2s;
        }

        .navbar-custom {
            background: var(--nav-bg);
        }

        .navbar-custom .nav-link,
        .navbar-custom .navbar-brand {
            color: var(--nav-text) !important;
        }

        .navbar-custom .navbar-brand {
            font-weight: 600;
            color: #ffffff !important;
        }

        .footer {
            color: #ffffff;
            background: var(--nav-bg) !important;
        }

        .btn-teal {
            background: #0F6E56;
            color: #E1F5EE;
            border: none;
        }

        .btn-teal:hover {
            background: #0B5744;
            color: #ffffff;
        }

        .btn-navy {
            background: #0C447C;
            color: #E6F1FB;
            border: none;
        }

        .btn-navy:hover {
            background: #093762;
            color: #ffffff;
        }

        .hero-section {
            background: var(--hero-bg);
            padding: 0;
        }

        .hero-section h1 {
            font-weight: 700;
        }

        .hero-section .btn-primary {
            background: #F2994A;
            border: none;
            color: #ffffff;
        }

        .hero-section .btn-primary:hover {
            background: #DB8236;
        }

        .feature-card {
            background: var(--feature-bg);
            color: var(--text-color);
            border-radius: 8px;
            box-shadow: 0 2px 10px rgba(0,0,0,.08);
        }

        .feature-card h4 {
            color: var(--heading-color);
            font-weight: 600;
        }

        .feature-card p {
            color: var(--muted-text);
        }

        .feature-card-link {
            cursor: pointer;
            transition: transform .15s ease, box-shadow .15s ease;
        }

        .feature-card-link:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 16px rgba(0,0,0,.12);
        }

        .cta-section {
            background: var(--cta-bg);
            color: var(--text-color);
        }

        .cta-section h2 {
            color: var(--heading-color);
            font-weight: 700;
        }

        .card,
        .modal-content,
        .dropdown-menu,
        .list-group-item {
            background-color: var(--surface-bg);
            color: var(--text-color);
            border-color: var(--border-color);
        }

        .dropdown-item {
            color: var(--text-color);
        }

        .dropdown-item:hover,
        .dropdown-item:focus {
            background-color: var(--cta-bg);
            color: var(--text-color);
        }

        main {
            color: var(--text-color);
        }

        main a:not(.btn) {
            color: var(--link-color);
        }

        .text-muted,
        .text-secondary {
            color: var(--muted-text) !important;
        }

        .form-control,
        .form-select {
            background-color: var(--input-bg);
            color: var(--text-color);
            border-color: var(--border-color);
        }

        .form-control:focus,
        .form-select:focus {
            background-color: var(--input-bg);
            color: var(--text-color);
            border-color: var(--link-color);
        }

        .form-control::placeholder {
            color: var(--muted-text);
        }

        .table {
            --bs-table-bg: var(--surface-bg);
            --bs-table-color: var(--text-color);
            --bs-table-border-color: var(--border-color);
            --bs-table-striped-bg: var(--page-bg);
            --bs-table-striped-color: var(--text-color);
            --bs-table-hover-bg: var(--cta-bg);
            --bs-table-hover-color: var(--text-color);
        }

        .theme-toggle {
            border: 1px solid var(--nav-text);
            border-radius: 20px;
            padding: 6px 10px;
            background: transparent;
            color: var(--nav-text);
            cursor: pointer;
            white-space: nowrap;
            font-size: .9rem;
        }

        .theme-toggle:hover {
            background: rgba(255,255,255,.12);
        }

        .theme-toggle:focus-visible {
            outline: 2px solid #F2994A;
            outline-offset: 3px;
        }

        /* Password visibility controls */
        .pw-wrap {
            position: relative;
            display: block;
            width: fit-content;
            max-width: 100%;
        }

        .pw-wrap input {
            padding-right: 4.5rem;
        }

        .pw-toggle {
            position: absolute;
            top: 50%;
            right: .5rem;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: var(--link-color);
            font-size: .85rem;
            font-weight: 600;
            cursor: pointer;
            padding: .25rem .5rem;
        }

        .pw-toggle:hover {
            opacity: .8;
        }

        @media (prefers-reduced-motion: reduce) {
            body, .feature-card-link {
                transition: none;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold" href="~/Default.aspx" runat="server">Multigroup Inc.</a>

                <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navMenu"
                    aria-controls="navMenu" aria-expanded="false"
                    aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="~/Default.aspx" runat="server">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Products.aspx" runat="server">Shop</a></li>
                        <li class="nav-item">
                            <a class="nav-link" id="lnkCartCount" runat="server" href="~/Cart.aspx">Cart</a>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="~/TrackDelivery.aspx" runat="server">Track Delivery</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/MyOrders.aspx" runat="server">My Orders</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/MyAccount.aspx" runat="server">My Account</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/About.aspx" runat="server">About Us</a></li>
                        <li class="nav-item"><a class="nav-link" href="~/Contact.aspx" runat="server">Contact</a></li>
                    </ul>

                    <ul class="navbar-nav me-lg-2">
                        <li class="nav-item d-flex align-items-center py-2 py-lg-0">
                            <button type="button" id="themeToggle"
                                class="theme-toggle"
                                aria-label="Switch to dark mode"
                                aria-pressed="false">
                                <span id="themeIcon" aria-hidden="true">🌙</span>
                                <span id="themeLabel">Dark mode</span>
                            </button>
                        </li>
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <asp:HyperLink ID="lnkCustomerAuth" runat="server"
                                CssClass="nav-link"
                                NavigateUrl="~/Account/CustomerLogin.aspx">Log In</asp:HyperLink>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="~/Wishlist.aspx" runat="server">&#9829; Wishlist</a>
                        </li>
                        <li class="nav-item">
                            <asp:HyperLink ID="lnkRegister" runat="server"
                                CssClass="nav-link"
                                NavigateUrl="~/Account/Register.aspx">Register</asp:HyperLink>
                        </li>
                        <li class="nav-item">
                            <asp:LinkButton ID="btnCustomerLogout" runat="server"
                                CssClass="nav-link"
                                OnClick="btnCustomerLogout_Click">Log Out</asp:LinkButton>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="lnkStaffLogin" runat="server"
                                href="~/Account/Login.aspx">Staff Login</a>
                        </li>

                        <li class="nav-item dropdown" id="liStaffMenu"
                            runat="server" visible="false">
                            <a class="nav-link dropdown-toggle" href="#"
                                id="ddlStaffMenu" role="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                                Staff Menu
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="ddlStaffMenu">
                                <li><a class="dropdown-item" href="~/Admin/AddProduct.aspx" runat="server">Add Product</a></li>
                                <li><a class="dropdown-item" href="~/Admin/AddSupplier.aspx" runat="server">Add Supplier</a></li>
                                <li><a class="dropdown-item" href="~/Admin/OrderLogistics.aspx" runat="server">Order Logistics</a></li>
                                <li><a class="dropdown-item" href="~/Admin/Reports.aspx" runat="server">Reports</a></li>
                                <li><a class="dropdown-item" href="~/Admin/StaffDataCapture.aspx" runat="server">Staff Data Capture</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <asp:LinkButton ID="btnStaffLogout" runat="server"
                                        CssClass="dropdown-item"
                                        OnClick="btnStaffLogout_Click">Staff Log Out</asp:LinkButton>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <main class="container my-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="footer text-center py-3 mt-5" style="background:#0C2A44;">
            <div class="container">
                <p class="mb-0">&copy; <%: DateTime.Now.Year %> Multigroup Inc. All rights reserved.</p>
                <p class="mb-0">
                    <a href="~/PrivacyPolicy.aspx" runat="server"
                        style="color:#CDE0F2; text-decoration:underline;">Privacy Policy</a>
                </p>
            </div>
        </footer>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <!-- Password visibility toggle -->
        <script>
            (function () {
                document.querySelectorAll('input[type="password"]').forEach(function (input) {
                    if (input.dataset.pwToggleAdded === "true") return;
                    input.dataset.pwToggleAdded = "true";

                    var wrap = document.createElement('div');
                    wrap.className = 'pw-wrap';
                    input.parentNode.insertBefore(wrap, input);
                    wrap.appendChild(input);

                    var btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'pw-toggle';
                    btn.textContent = 'Show';
                    btn.setAttribute('aria-label', 'Show password');

                    btn.addEventListener('click', function () {
                        var reveal = input.type === 'password';
                        input.type = reveal ? 'text' : 'password';
                        btn.textContent = reveal ? 'Hide' : 'Show';
                        btn.setAttribute('aria-label',
                            reveal ? 'Hide password' : 'Show password');
                    });

                    wrap.appendChild(btn);
                });
            })();
        </script>

        <!-- Dark mode toggle -->
        <script>
            (function () {
                var toggle = document.getElementById("themeToggle");
                var icon = document.getElementById("themeIcon");
                var label = document.getElementById("themeLabel");

                if (!toggle || !icon || !label) return;

                function applyTheme(theme, save) {
                    var dark = theme === "dark";

                    document.documentElement.setAttribute("data-theme", theme);
                    icon.textContent = dark ? "☀️" : "🌙";
                    label.textContent = dark ? "Light mode" : "Dark mode";

                    toggle.setAttribute("aria-label",
                        dark ? "Switch to light mode" : "Switch to dark mode");
                    toggle.setAttribute("aria-pressed", dark ? "true" : "false");

                    if (save) {
                        try {
                            localStorage.setItem("siteTheme", theme);
                        } catch (e) { }
                    }
                }

                var savedTheme = null;
                try {
                    savedTheme = localStorage.getItem("siteTheme");
                } catch (e) { }

                applyTheme(savedTheme === "dark" ? "dark" : "light", false);

                toggle.addEventListener("click", function () {
                    var currentlyDark =
                        document.documentElement.getAttribute("data-theme") === "dark";

                    applyTheme(currentlyDark ? "light" : "dark", true);
                });
            })();
        </script>

        <!-- Cookie consent -->
        <div id="cookieConsentBanner"
            class="alert alert-dark d-none"
            style="position:fixed; bottom:0; left:0; right:0; z-index:1050; border-radius:0; margin-bottom:0;">

            <div class="container d-flex justify-content-between align-items-center flex-wrap">
                <span class="me-3">
                    We use cookies to improve your experience on this site
                    (e.g. to remember your login). By continuing to browse,
                    you agree to our use of cookies.
                    <a href="~/PrivacyPolicy.aspx" runat="server"
                        class="text-light text-decoration-underline">Learn more</a>
                </span>
                <button type="button" class="btn btn-teal btn-sm"
                    onclick="acceptCookieConsent()">Accept</button>
            </div>
        </div>

        <script>
            function acceptCookieConsent() {
                document.cookie = "CookieConsent=accepted; max-age=" +
                    (60 * 60 * 24 * 365) + "; path=/; SameSite=Lax";
                document.getElementById('cookieConsentBanner')
                    .classList.add('d-none');
            }

            (function checkCookieConsent() {
                if (document.cookie.indexOf('CookieConsent=accepted') === -1) {
                    document.getElementById('cookieConsentBanner')
                        .classList.remove('d-none');
                }
            })();
        </script>
    </form>
    <style>
    #mgChat { position: fixed; left: 24px; bottom: 24px; z-index: 10000; font-family: inherit; }

    #mgChatToggle {
        width: 58px; height: 58px; border-radius: 50%; border: none;
        background: #008c98; color: #fff; font-size: 26px; cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,.25); transition: background .2s ease;
    }
    #mgChatToggle:hover { background: #006e79; }

    #mgChatPanel {
        position: absolute; left: 0; bottom: 72px;
        width: 360px; max-width: calc(100vw - 32px); height: 480px; max-height: calc(100vh - 120px);
        background: #fff; border: 1px solid #e2e9ef; border-radius: 16px;
        box-shadow: 0 12px 36px rgba(16,38,62,.22);
        display: flex; flex-direction: column; overflow: hidden;
    }
    #mgChatPanel[hidden] { display: none; }

    #mgChatPanel header {
        background: linear-gradient(115deg, #10263e, #18485b); color: #fff;
        padding: 14px 16px; display: flex; justify-content: space-between; align-items: center;
        font-weight: 700;
    }
    #mgChatClose { background: none; border: none; color: #fff; font-size: 24px; line-height: 1; cursor: pointer; }

    #mgChatLog { flex: 1; overflow-y: auto; padding: 14px; background: #f5f8fb; }

    .mgMsg {
        max-width: 85%; margin-bottom: 10px; padding: 9px 13px; border-radius: 14px;
        font-size: 14px; line-height: 1.45; white-space: pre-line; overflow-wrap: anywhere;
    }
    .mgMsg.bot { background: #fff; color: #10263e; border: 1px solid #e2e9ef; border-bottom-left-radius: 4px; }
    .mgMsg.user { background: #008c98; color: #fff; margin-left: auto; border-bottom-right-radius: 4px; }
    .mgMsg a {
        display: inline-block; margin-top: 8px; margin-right: 6px; padding: 5px 12px;
        background: #e6f5f6; color: #006e79; border-radius: 999px; font-weight: 600; text-decoration: none;
    }
    .mgMsg a:hover { background: #cdebed; }

    #mgChatChips { padding: 8px 12px 0; display: flex; flex-wrap: wrap; gap: 6px; background: #fff; }
    #mgChatChips button {
        border: 1px solid #008c98; background: #fff; color: #008c98; border-radius: 999px;
        padding: 4px 12px; font-size: 12px; font-weight: 600; cursor: pointer;
    }
    #mgChatChips button:hover { background: #008c98; color: #fff; }

    .mgChatForm { display: flex; gap: 8px; padding: 12px; background: #fff; }
    .mgChatForm input {
        flex: 1; border: 1px solid #ccd6df; border-radius: 9px; padding: 9px 12px; font-size: 14px; min-width: 0;
    }
    .mgChatForm button {
        background: #008c98; color: #fff; border: none; border-radius: 9px; padding: 0 16px; font-weight: 600; cursor: pointer;
    }
    .mgChatForm button:disabled { background: #aab7c2; cursor: not-allowed; }
</style>

<div id="mgChat"
     data-auth='<%= Session["CustomerID"] != null ? "1" : "0" %>'
     data-url='<%= ResolveUrl("~/ChatHandler.ashx") %>'>

    <button type="button" id="mgChatToggle" aria-label="Open chat assistant" aria-expanded="false">&#128172;</button>

    <section id="mgChatPanel" role="dialog" aria-label="MultiGroup assistant" hidden>
        <header>
            <span>MultiGroup Assistant</span>
            <button type="button" id="mgChatClose" aria-label="Close chat">&times;</button>
        </header>

        <div id="mgChatLog" aria-live="polite"></div>

        <div id="mgChatChips">
            <button type="button" data-q="Where is my order?">My orders</button>
            <button type="button" data-q="What's in my cart?">My cart</button>
            <button type="button" data-q="Delivery information">Delivery</button>
        </div>

        <div class="mgChatForm">
            <input type="text" id="mgChatInput" maxlength="300" autocomplete="off"
                   placeholder="Type your question..." aria-label="Chat message" />
            <button type="button" id="mgChatSend">Send</button>
        </div>
    </section>
</div>

<script>
    (function () {
        var root = document.getElementById("mgChat");
        if (!root) return;

        var url = root.getAttribute("data-url");
        var auth = root.getAttribute("data-auth");   // "1" = logged in, "0" = logged out

        var KEY = "mgChat";
        var AUTH_KEY = "mgChatAuth";
        var OPEN_KEY = "mgChatOpen";

        var panel = document.getElementById("mgChatPanel");
        var toggle = document.getElementById("mgChatToggle");
        var log = document.getElementById("mgChatLog");
        var input = document.getElementById("mgChatInput");
        var sendBtn = document.getElementById("mgChatSend");
        var history = [];

        // If the login state changed since the last page load (logged in or logged out),
        // wipe the old conversation so nothing carries over between accounts.
        try {
            var lastAuth = sessionStorage.getItem(AUTH_KEY);
            if (lastAuth !== null && lastAuth !== auth) {
                sessionStorage.removeItem(KEY);
                sessionStorage.removeItem(OPEN_KEY);
            }
            sessionStorage.setItem(AUTH_KEY, auth);
        } catch (e) { }

        function save() {
            try { sessionStorage.setItem(KEY, JSON.stringify(history)); } catch (e) { }
        }

        function render(role, text, links) {
            var div = document.createElement("div");
            div.className = "mgMsg " + role;
            div.textContent = text;                      // textContent = no HTML injection

            (links || []).forEach(function (l) {
                var a = document.createElement("a");
                a.href = l.url;
                a.textContent = l.text;
                div.appendChild(document.createElement("br"));
                div.appendChild(a);
            });

            log.appendChild(div);
            log.scrollTop = log.scrollHeight;
            return div;
        }

        function addMessage(role, text, links) {
            render(role, text, links);
            history.push({ role: role, text: text, links: links || [] });
            save();
        }

        function ask(message, showUserBubble) {
            if (showUserBubble) addMessage("user", message);

            sendBtn.disabled = true;
            var typing = render("bot", "Typing...");

            fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "message=" + encodeURIComponent(message)
            })
                .then(function (r) {
                    if (!r.ok) throw new Error("HTTP " + r.status);
                    return r.json();
                })
                .then(function (data) {
                    log.removeChild(typing);
                    addMessage("bot", data.reply, data.links);
                })
                .catch(function (err) {
                    log.removeChild(typing);
                    // Shown but NOT saved to history, so a fixed server works on the next open
                    render("bot", "Sorry, I couldn't reach the server. Please try again.");
                })
                .then(function () { sendBtn.disabled = false; input.focus(); });
        }

        function submit() {
            var text = input.value.trim();
            if (!text || sendBtn.disabled) return;
            input.value = "";
            ask(text, true);
        }

        function open() {
            panel.hidden = false;
            toggle.setAttribute("aria-expanded", "true");
            try { sessionStorage.setItem(OPEN_KEY, "1"); } catch (e) { }

            // First time opened: ask the server for a (personalised) greeting
            if (history.length === 0) ask("hi", false);
            input.focus();
        }

        function close() {
            panel.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            try { sessionStorage.removeItem(OPEN_KEY); } catch (e) { }
        }

        // Restore history after page navigation
        try {
            history = JSON.parse(sessionStorage.getItem(KEY) || "[]");
            history.forEach(function (m) { render(m.role, m.text, m.links); });
            if (sessionStorage.getItem(OPEN_KEY) === "1") {
                panel.hidden = false;
                toggle.setAttribute("aria-expanded", "true");
            }
        } catch (e) { history = []; }

        toggle.addEventListener("click", function () { panel.hidden ? open() : close(); });
        document.getElementById("mgChatClose").addEventListener("click", close);
        sendBtn.addEventListener("click", submit);
        input.addEventListener("keydown", function (e) {
            if (e.key === "Enter") { e.preventDefault(); submit(); }
        });

        document.querySelectorAll("#mgChatChips button").forEach(function (b) {
            b.addEventListener("click", function () { ask(b.getAttribute("data-q"), true); });
        });
    })();
</script>
</body>
</html>
